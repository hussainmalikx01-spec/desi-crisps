# ============================================
# SITE URL — optional, used for sitemap.xml, robots.txt, and SEO tags
# ============================================
# Set this once you have a real domain, e.g. https://desicrisps.pk
# If left empty, falls back to Vercel's auto-generated URL, then localhost.
NEXT_PUBLIC_SITE_URL=""

# ============================================
# DATABASE — required
# ============================================
# Get this from your database provider (Neon, Supabase, or Railway).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/desicrisps"

# ============================================
# NEXTAUTH — required (admin login)
# ============================================
# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-character-secret"
# The full URL of your deployed site (or http://localhost:3000 for local dev)
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# CLOUDINARY — required for image uploads (products, logo)
# ============================================
# Sign up free at https://cloudinary.com — find these on your dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================
# WHATSAPP BUSINESS CLOUD API — optional (order notifications)
# ============================================
# Set up at https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# The number that should receive "new order" alerts (your business number)
WHATSAPP_ADMIN_NUMBER=""

# ============================================
# EMAIL (RESEND) — optional, fallback notification channel
# ============================================
# Sign up free at https://resend.com
RESEND_API_KEY=""
# Must be a verified sending domain/email in Resend
NOTIFICATION_FROM_EMAIL="orders@desicrisps.pk"
# Where "new order" and contact-form alert emails are sent
NOTIFICATION_ADMIN_EMAIL="hello@desicrisps.pk"

# ============================================
# SEED DATA — optional, only used the first time you run `npx prisma db seed`
# ============================================
SEED_ADMIN_EMAIL="admin@desicrisps.pk"
SEED_ADMIN_PASSWORD="ChangeMe123!"
